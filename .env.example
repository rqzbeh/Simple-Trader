# Simple-Trader — Example environment configuration
#
# Copy this file to ".env" and fill in the secret keys and values relevant
# for your environment. Do NOT commit your real secrets to source control.
#
# NOTE: Values below are examples and sensible defaults for a local/dev setup.
#       Tweak them to match your account, risk preferences, provider keys, and
#       operational limits.

# ---------- General runtime & DB ----------
DATABASE_PATH=simple_trader.db          # Path to SQLite DB (relative to repo or absolute)
TENANT_ID=default                       # SaaS tenant namespace (letters/numbers/-/_)
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
TIMEZONE=UTC                           # Default timezone for timestamps (e.g., UTC)

# ---------- Account & Risk Management ----------
ACCOUNT_BALANCE_USD=100000.0           # Used for position-sizing calculations (USD)
RISK_PER_TRADE_PCT=0.01                # Fraction of account risked per trade (0.01 = 1%)
MIN_RISK_REWARD_RATIO=3.0              # Minimum R:R (take_profit distance / risk) required
STOP_LOSS_SLIPPAGE_PCT=0.001           # Slippage estimate to account for when suggesting SLs

MAX_LEVERAGE_CRYPTO=10                 # Maximum allowable leverage for crypto signals
MAX_LEVERAGE_FOREX=30                  # Maximum allowable leverage for forex signals

# ---------- Timeframes & Trade Duration ----------
TIMEFRAME_HOURS=2                      # Primary analysis timeframe in hours (2H)
MAX_TRADE_DURATION_HOURS=24            # Maximum time a trade may remain open
NEWS_MAX_AGE_HOURS=24                  # Ignore news older than this for signal generation

# ---------- News sources ----------
# A comma-separated list of RSS URLs (default commonly used feeds)
NEWS_RSS_FEEDS=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss/,https://www.reuters.com/finance/markets/rss

# News API keys (optional)
NEWS_API_KEY=                           # Optional: NewsAPI.org key (free tier)
CRYPTONEWS_API_KEY=                     # Optional: Crypto-specific news provider key

# ---------- Market data (forex/crypto) ----------
# AlphaVantage (required for FX intraday at present)
ALPHAVANTAGE_API_KEY=                   # Required for forex intraday OHLC (free tier available)
# CoinGecko is used for crypto data (no key required by default)

# ---------- LLM Providers ----------
# Provide API keys & endpoints for each provider you want to enable.
# If none are provided, the system will run in 'mock' LLM mode, which is good for offline testing.

# Groq (example)
GROQ_API_KEY=                           # Your GROQ API key (if available)
GROQ_API_ENDPOINT=https://api.groq.ai/v1  # Optional override endpoint
GROQ_RATE_LIMIT_PER_MINUTE=20
GROQ_WEIGHT=1

# Cloudflare (example)
CLOUDFLARE_API_KEY=                     # Your Cloudflare API token (if using Cloudflare LLM)
CLOUDFLARE_API_ENDPOINT=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT/worker_routes
CLOUDFLARE_RATE_LIMIT_PER_MINUTE=20
CLOUDFLARE_WEIGHT=1

# Google (example)
GOOGLE_AI_API_KEY=                      # Your Google AI Studio / Vertex AI key if available
GOOGLE_AI_API_ENDPOINT=https://generative.googleapis.com/v1beta2/models/YOUR_MODEL
GOOGLE_WEIGHT=1
GOOGLE_RATE_LIMIT_PER_MINUTE=20

# LLM runtime knobs
LLM_GLOBAL_CONCURRENCY=5                # Max concurrent LLM requests (global across providers)
LLM_MIN_CONFIDENCE=0.6                  # Minimum LLM confidence to accept an analysis result

# ---------- Candlestick / Pattern filter ----------
MIN_PATTERN_CONFIDENCE=0.6              # Minimum confidence for a candlestick pattern to be considered
OPEN_POSITIONS_LIMIT=10                 # Limit on concurrently open signals

# ---------- Telegram (alerts) ----------
TELEGRAM_BOT_TOKEN=                     # Bot token "bot123:ABC..." (format: 123456:abcdef...)
TELEGRAM_CHAT_ID=                       # Chat id (int). For groups: negative number like -1001234567890

# Set BACKTEST_MODE to true to suppress Telegram messages / real-world notifications
BACKTEST_MODE=true                       # true/false - when true, the system won't send live Telegram messages

# ---------- Misc ----------
ENABLE_TELEMETRY=true                   # Whether to enable LLM usage logging for monitoring/analysis
RUNTIME_AUTO_APPLY_TUNER=true           # Auto-apply tuner suggestions (true/false) — toggles automatic live tuning changes
NEWS_FETCH_LIMIT=100                    # How many news items to fetch per run
OPEN_TRADES_PER_SYMBOL_LIMIT=1          # (Optional) avoid opening many signals for the same symbol

# ---------- Notes & recommendations ----------
# - For AlphaVantage and some LLM providers, rate limits apply for free tiers, be sure to set *_RATE_LIMIT_PER_MINUTE
#   to match the limits of the account keys you are using.
# - When integrating LLM providers, the API endpoints and the payload format may vary.
#   The code includes a generic HTTP adapter — adapt the client for specific provider payloads if needed.
# - `BACKTEST_MODE=true` is recommended for initial testing to avoid sending repeated Telegram messages.
# - `ACCOUNT_BALANCE_USD` is used only for position-sizing recommendations and not enforced on exchanges.
# - Keep API keys secret. Use secure secrets management for production deployments.
#
# ---------- Example (commented) ----------
# DATABASE_PATH=/data/simple_trader.db
# LOG_LEVEL=DEBUG
# ACCOUNT_BALANCE_USD=200000.0
# RISK_PER_TRADE_PCT=0.005
# NEWS_RSS_FEEDS=https://cointelegraph.com/rss,https://www.reuters.com/finance/markets/rss
# ALPHAVANTAGE_API_KEY=YOUR_ALPHA_KEY
# GROQ_API_KEY=YOUR_GROQ_KEY
# TELEGRAM_BOT_TOKEN=bot123:ABCDEF
# TELEGRAM_CHAT_ID=-1001234567890
# BACKTEST_MODE=true
