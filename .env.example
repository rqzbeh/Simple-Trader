PORT=8080
DATABASE_URL=postgres://trader:REDACTED_DB_PASSWORD@localhost:5432/simple_trader?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Unified OpenAI-compatible AI Engine
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL_ID=
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=30
AI_REASONING_EFFORT=high

# Risk Management & Multi-Horizon 3-Tier Allocation
INITIAL_CAPITAL=10000.0
CORE_TARGET_PCT=0.50
ALPHA_TARGET_PCT=0.40
MAX_DRAWDOWN_LIMIT_PCT=0.08
MIN_RISK_PER_TRADE_PCT=0.005
KELLY_FRACTION=0.50
MAX_CONCURRENT_SIGNALS=3

# Optional — core-managed (spec-015, spec-019)
# unset = decision core chooses; set = user override; science-based samples in docs/RESEARCH-optimal-params.md
#MIN_RISK_TO_REWARD_RATIO=2.5
#DEFAULT_LEVERAGE=8
#MAX_RISK_PER_TRADE_PCT=0.02
#SL_ATR_MULT=1.5
#TP_ATR_MULT=3.0
#CLUSTER_DECAY_MODE=FAST_BREAKING
#CONFLUENCE_MIN=0.60
#EARLY_EXIT_ENABLED=true
#EARLY_EXIT_MIN_HOLD_MIN=30
#EARLY_EXIT_MAX_PER_DAY=3
#EARLY_EXIT_COOLDOWN_MIN=60
#EARLY_EXIT_CONF_FLOOR=0.75
#TIMEFRAME_SET_ALPHA=15m,1h,4h
#TIMEFRAME_SET_CORE=1h,4h,12h

# Dynamic Trading & Institutional Execution Bounds
MIN_STOP_LOSS_PCT=1.0
MAX_STOP_LOSS_PCT=3.5
MIN_TAKE_PROFIT_PCT=2.0
MAX_TAKE_PROFIT_PCT=8.0
MAKER_FEE_RATE=0.0002
TAKER_FEE_RATE=0.0005
MAX_SLIPPAGE_PCT=0.005
MAX_TRADE_MARGIN_PCT=0.15
SIGNAL_MAX_AGE_MINUTES=45
IMPACT_FACTOR=0.05

# Macroeconomic Calendar & Screener Liquidity
CALENDAR_HALT_MINUTES=15
ECONOMIC_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
SCREENER_MIN_24H_VOLUME=50000000.0
SCREENER_MAX_SPREAD_BPS=8

ENV=development
APP_SECRET=

# Authentication (REQUIRED in production)
ADMIN_PASSWORD=

# Telegram Signals Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Decision Core (spec-013 v3.0)
TYPESAFE_API_KEY=
ROUTING_CONFIDENCE_THRESHOLD=

# Optional backstop sweep: unset = event-driven only (fresh headline -> immediate evaluation);
# set = periodic sweep every N minutes (science: news alpha decays 15-30min — docs/RESEARCH-optimal-params.md)
#SCAN_INTERVAL_MINUTES=5

UPSTREAM_PROXY_URL=  # optional: socks5://host:port or http://host:port for Jev/9Router traffic

# Database (compose requires these)
POSTGRES_USER=trader
POSTGRES_PASSWORD=change_me
POSTGRES_DB=simple_trader

# Required keys (spec-017 — no in-code defaults; boot fails listing any missing)
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
DB_MAX_CONNS=25
DB_MIN_CONNS=5
