# Build Stage
FROM golang:alpine AS builder

WORKDIR /app

# Install git and ca-certificates
RUN apk add --no-cache git ca-certificates

# Copy go module files and download dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY migrations/ ./migrations/

# Compile static binary with zero CGO
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/simple-trader ./cmd/trader/main.go

# Production Minimal Stage
FROM alpine:3.20

WORKDIR /app

# Install ca-certificates and tzdata for TLS connections and timezones
RUN apk add --no-cache ca-certificates tzdata

# Copy compiled binary and migrations from builder
COPY --from=builder /app/simple-trader /app/simple-trader
COPY --from=builder /app/migrations /app/migrations

# Expose HTTP API & SSE port
EXPOSE 8080

# Run Simple-Trader
ENTRYPOINT ["/app/simple-trader"]
