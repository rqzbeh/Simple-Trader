# Frontend Build Stage with Bun
FROM --platform=$BUILDPLATFORM oven/bun:alpine AS frontend-builder

WORKDIR /web

COPY web/package.json web/bun.lock* ./
RUN bun install --no-cache

COPY web/ ./
RUN bun run build

# Backend Go Build Stage
FROM --platform=$BUILDPLATFORM golang:alpine AS builder

WORKDIR /app

# Install git and ca-certificates
RUN apk add --no-cache git ca-certificates

# Copy go module files and download dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY migrations/ ./migrations/

ARG TARGETOS
ARG TARGETARCH

# Compile static binary with zero CGO using Go native cross-compilation
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -ldflags="-w -s" -o /app/simple-trader ./cmd/trader/main.go

# Production Minimal Stage
FROM alpine:3.20

WORKDIR /app

# Install ca-certificates and tzdata for TLS connections and timezones
RUN apk add --no-cache ca-certificates tzdata

# Copy compiled binary and migrations from builder
COPY --from=builder /app/simple-trader /app/simple-trader
COPY --from=builder /app/migrations /app/migrations

# Copy compiled frontend PWA assets for direct serving by Go backend
COPY --from=frontend-builder /web/dist /app/web/dist

# Expose HTTP API & SSE port
EXPOSE 8080

# Run Simple-Trader
ENTRYPOINT ["/app/simple-trader"]
